# [ Testado en Arch Linux | SSH Hardening Híbrido Post-Quantum ]
# [ OpenSSH_10.6p2 | OpenSSL 4.1.0 ]

# [ Autenticación clásica compatible: ed25519 ]
# [ Autenticación híbrida Post-Quantum: ML-DSA/Ed25519 ]
# [ KEX Híbrido Post-Quantum: ML-KEM-768/X25519, NTRU Prime/X25519 ]

# [ GENERAR ssh-key HÍBRIDA Post-Quantum EN CLIENTE ]
#
# [ SIN Passphrase ]
# ssh-keygen -t mldsa44-ed25519 -f ~/.ssh/id_mldsa44_ed25519_1 -N '' -C "postquantum-ssh-key"
#
# [ CON Passphrase ]
# ssh-keygen -t mldsa44-ed25519 -a 100 -f ~/.ssh/id_mldsa44_ed25519_2 -C "postquantum-ssh-key"

# [ GENERAR ssh-key ed25519 EN CLIENTE ]
#
# [ SIN Passphrase ]
# ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_1 -N '' -C "ssh-ed25519"
#
# [ CON Passphrase ]
# ssh-keygen -t ed25519 -a 100 -f ~/.ssh/id_ed25519_2 -C "ssh-ed25519"

# [ NETWORK ]
AddressFamily inet
ListenAddress 192.168.1.131
Port 18713

# [ AUTENTICACIÓN ]
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
UsePAM yes

AuthenticationMethods publickey

AllowUsers bogart

MaxAuthTries 3
MaxSessions 2
LoginGraceTime 30

# [ INTERCAMBIO DE CLAVES POST-QUANTUM ]
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512

# [ AUTENTICACIÓN DE HOST POST-QUANTUM ]
HostKey /etc/ssh/ssh_host_mldsa44_ed25519_key
HostKey /etc/ssh/ssh_host_ed25519_key
HostKeyAlgorithms ssh-mldsa44-ed25519,ssh-ed25519

# [ AUTENTICACIÓN DE USUARIOS POST-QUANTUM ]
PubkeyAcceptedAlgorithms ssh-mldsa44-ed25519,ssh-ed25519

# [ CIFRADO SIMÉTRICO ]
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com

# [ AUTENTIFICACIÓN DE MENSAJES ]
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# [ SEGURIDAD DE LA SESIÓN ]
PermitTTY yes
DisableForwarding yes
PermitTunnel no

PrintMotd no

# [ LÍMITE DE CONEXIONES ]
MaxStartups 10:30:30
PerSourceMaxStartups 3
PerSourcePenalties yes

ClientAliveInterval 60
ClientAliveCountMax 3

# [ REKEYING ]
RekeyLimit 1G 1h

# [ LOGGING ]
LogLevel VERBOSE
SyslogFacility AUTH

# [ SEGURIDAD ADICIONAL ]
HostbasedAuthentication no
IgnoreRhosts yes
GSSAPIAuthentication no
